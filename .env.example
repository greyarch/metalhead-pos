# myPOS fiscal device, initial fallback only — the app rescans the LAN on load
PUBLIC_POS_URL=http://192.168.8.104:8080/jsonrpc

# myPOS request timeout in ms. Default 45000; raise it for a slow device.
PUBLIC_POS_TIMEOUT_MS=45000

# PocketBase, dev only. In production the app is served BY PocketBase, so same origin.
PUBLIC_PB_URL=http://127.0.0.1:8090
